# App
AFF_ENV=dev
AFF_DATA_DIR=./data
AFF_API_HOST=0.0.0.0
AFF_API_PORT=8000

# LLM provider: openai_compatible | ollama
AFF_LLM_PROVIDER=ollama
AFF_LLM_API_BASE=http://127.0.0.1:11434/v1
AFF_LLM_API_KEY=
AFF_LLM_MODEL=qwen2.5:7b
AFF_EMBEDDING_MODEL=nomic-embed-text

# Optional separate roles (LightRAG)
# AFF_EXTRACT_MODEL=
# AFF_QUERY_MODEL=

# Limits
AFF_MAX_UPLOAD_MB=50
AFF_MAX_TABLE_ROWS=50
