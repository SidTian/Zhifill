{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-form-fill.local/schemas/v0/fill_result.schema.json",
  "title": "FillAndParseResults",
  "$defs": {
    "ParseFormResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "format", "fields", "structure_notes"],
      "properties": {
        "job_id": { "type": "string" },
        "format": { "type": "string", "enum": ["xlsx", "docx", "pdf"] },
        "fields": {
          "type": "array",
          "items": { "$ref": "form_field.schema.json" }
        },
        "structure_notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "FillResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "fields", "stats"],
      "properties": {
        "job_id": { "type": "string" },
        "fields": {
          "type": "array",
          "items": { "$ref": "form_field.schema.json" }
        },
        "stats": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filled", "empty", "low_confidence"],
          "properties": {
            "filled": { "type": "integer", "minimum": 0 },
            "empty": { "type": "integer", "minimum": 0 },
            "low_confidence": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "ExportResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["job_id", "output"],
      "properties": {
        "job_id": { "type": "string" },
        "output": {
          "type": "object",
          "required": ["path", "filename", "mime", "sha256", "size"]
        },
        "side_files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "filename", "mime", "sha256", "size"]
          }
        }
      }
    }
  }
}
